/** CertiVault Google Apps Script backend. Deploy as Web App: execute as you; access anyone. */
const SHEET_NAME='Certificates';
function doGet(e){const a=e.parameter.action||'verify',id=(e.parameter.id||'').trim();if(a==='verify')return json(find(id));return json({error:'Unsupported action'});}
function doPost(e){const body=JSON.parse(e.postData.contents);if(body.action==='bulkUpload')return json(bulkUpload(body.records||[]));return json({error:'Unsupported action'});}
function find(id){const sh=sheet(),rows=sh.getDataRange().getValues(),head=rows.shift();const i=head.indexOf('Certificate ID'),r=rows.find(x=>String(x[i]).toLowerCase()===id.toLowerCase());if(!r)return null;let o={};head.forEach((h,n)=>o[h]=r[n]);return {id:o['Certificate ID'],name:o['Learner Name'],program:o.Program,purpose:o.Purpose,issueDate:o['Issue Date'],template:o.Template,organization:o['Organization Name'],status:o['Verification Status']||'Active'};}
function bulkUpload(records){const sh=sheet(),known=sh.getDataRange().getValues().slice(1).map(r=>String(r[0])),out={successful:0,duplicates:0,errors:0};records.forEach(r=>{if(!r.id||!r.name){out.errors++;return}if(known.includes(r.id)){out.duplicates++;return}sh.appendRow([r.id,r.name,r.program,r.purpose,r.issueDate,r.template,r.organization,'', 'Active',new Date(),0,0]);out.successful++});return out;}
function sheet(){const ss=SpreadsheetApp.getActive(),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(['Certificate ID','Learner Name','Program','Purpose','Issue Date','Template','Organization Name','QR URL','Verification Status','Created Date','Verification Count','Download Count']);return sh;}
function json(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
